<#@ template cleanws="true" #>
import { ChannelGroupId, ChannelId, ClientDbId, ClientId, ClientType, EccKeyPubP256, IconId, IpAddr,
	MaxClients, OffsetDateTime, RustDuration, ServerGroupId, SocketAddr, TalkPowerRequest, Uid,
} from "./ts";
import { datetimeDeserialize, durationDeserialize } from "./util";
import { Duration, Moment } from "moment";
<#
let structs = filter_structs(&self.book.structs);

let mut base_structs = Vec::new();
for struc in &structs {
	base_structs.push(format!("{}Base", struc.name));
} #>
import { <#= base_structs.join(", ") #> } from "./bookBase";

// Enums

<#
use tsproto_structs::{enums, errors, versions};

for e in &enums::DATA.enums { #>
export enum <#= e.name #> {
<# for v in &e.variants { #>
	<#= v.name #> = "<#= v.name #>",
<# } #>
}

<# } #>
export const enum TsError {
<# for v in &errors::DATA.0 { #>
	<#= v.name.to_camel_case() #> = "<#= v.name.to_camel_case() #>",
<# } #>
}

export function TsErrorDescription(error: TsError): string {
	switch (error) {
	<# for v in &errors::DATA.0 { #>
		case TsError.<#= v.name.to_camel_case() #>: return "<#= v.doc #>";
	<# } #>
	}
}

export const enum Version {
<# for v in &versions::DATA.0 { #>
	<#= v.get_enum_name() #> = "<#= v.get_enum_name() #>",
<# } #>
}

<# for e in &enums::DATA.bitflags { #>
export enum <#= e.name #> {
<# for v in &e.variants { #>
	<#= v.name #> = "<#= v.name #>",
<# } #>
}

<# } #>

// Structs

<#
for struc in &structs { #>
export class <#= struc.name #>Gen extends <#= struc.name #>Base {
	<#
	for p in &struc.properties {
		let mut struct_type = p.get_type()?;
		if self.book.structs.iter().any(|s| s.name == p.type_s) {
			// Append Gen
			let mut inner = &mut struct_type.inner;
			if let InnerRustType::Option(t) = inner {
				inner = &mut *t;
			}
			if let InnerRustType::Struct(t) = &mut inner {
				let name = format!("{}Gen", t);
				*t = name;
			}
		}
		#>
	public readonly <#= p.name.to_mixed_case() #>!: <# struct_type.inner.fmt_ts(_fmt)?; #>;
		<# if self.has_render(&struc.name, &p.name) { #>
	public readonly <#= p.name.to_mixed_case() #>Rendered!: string<# if p.opt { #> | null<# } #>;
	<# }
	} #>

	public update(obj: Partial<this> | Partial<<#= struc.name #>Gen>): this {
	<#
	// Preprocess properties
	for p in &struc.properties {
		let struct_type = p.get_type()?;
		let inner = struct_type.inner.peel_opt();
		let name = p.name.to_mixed_case();
		if let InnerRustType::Primitive(t) = inner {
			if t == "OffsetDateTime" { #>
		if (obj.<#= name #>)
			(obj as any).<#= name #> = datetimeDeserialize((obj as any).<#= name #>);
			<# } else if t == "Duration" { #>
		if (obj.<#= name #>)
			(obj as any).<#= name #> = durationDeserialize((obj as any).<#= name #>);
			<# }
		} else if self.book.structs.iter().any(|s| s.name == p.type_s) { #>
		if (obj.<#= name #> !== undefined && obj.<#= name #> !== null)
			(obj as any).<#= name #> = <#= p.type_s #>Gen.fromJson(obj.<#= name #>!);
		<# }
	} #>
		Object.assign(this, obj);
		return this;
	}
	<# if struc.opt { #>

	public static fromJson(obj: Partial<<#= struc.name #>Gen>): <#= struc.name #>Gen {
		return new <#= struc.name #>Gen().update(obj);
	}
	<# } #>
}

<# }

for struc in &structs { #>
interface IMsgPropertyId<#= struc.name #> {
	<# if struc.id.len() == 1 {
		let p = struc.id[0].find_property(&self.book.structs);
		let struct_type = p.get_type()?;
		#>
	<#= struc.name #>: <# struct_type.inner.fmt_ts(_fmt)?; #>;
	<# } else {
		let mut is_first = true;
		#>
	<#= struc.name #>: [<# for id in &struc.id {
			if is_first {
				is_first = false;
			} else {
				#>, <#
			}
			let p = id.find_property(&self.book.structs);
			p.get_type()?.inner.fmt_ts(_fmt)?;
		} #>];
	<# } #>
}

<# } #>
interface IMsgPropertyIdClientServerGroup {
	ClientServerGroup: [ClientId, ServerGroupId];
}

interface IMsgPropertyIdServerIp {
	ServerIp: IpAddr;
}

export type PropertyId =
<#
let mut is_first = true;
for struc in &structs {
	if is_first {
		is_first = false; #>
	IMsgPropertyId<#= struc.name #>
	<# } else { #>
	| IMsgPropertyId<#= struc.name #>
<# }
} #>
	| IMsgPropertyIdClientServerGroup
	| IMsgPropertyIdServerIp;

<# for struc in &structs { #>
interface IMsgPropertyValue<#= struc.name #> {
	<#= struc.name #>: Partial<<#= struc.name #>Gen>;
}

<# } #>
interface IMsgPropertyValueIpAddr {
	IpAddr: IpAddr;
}

interface IMsgPropertyValueServerGroupId {
	ServerGroupId: ServerGroupId;
}

export type PropertyValue =
<#
let mut is_first = true;
for struc in &structs {
	if is_first {
		is_first = false; #>
	IMsgPropertyValue<#= struc.name #>
	<# } else { #>
	| IMsgPropertyValue<#= struc.name #>
<# }
} #>
	| IMsgPropertyValueIpAddr
	| IMsgPropertyValueServerGroupId;

// Messages

<# for msg in &self.js_in_messages.0 { #>
<# if !msg.attributes.is_empty() { #>
export interface IMsg<#= msg.name #> {
	<#= msg.name #>: IMsg<#= msg.name #>Part[];
}

export interface IMsg<#= msg.name #>Part {
<# for a in &msg.attributes {
	let field = self.messages.get_field(a);
	let rust_type = field.get_type(a)?; #>
	<#= field.pretty.to_mixed_case() #>: <# rust_type.inner.fmt_ts_opts(_fmt, false)?; #>;
	<# if self.has_render(&msg.name, &field.pretty) { #>
	<#= field.pretty.to_mixed_case() #>Rendered: string<# if rust_type.is_opt() { #> | null<# } #>;
<# }
} #>
}

<# } else { #>
export interface IMsg<#= msg.name #> {
	<#= msg.name #>: {};
};

<# } #>
<# } #>
export type InMessage =
<#
let mut is_first = true;
for msg in &self.js_in_messages.0 {
	if is_first {
		is_first = false; #>
	IMsg<#= msg.name #>
	<# } else { #>
	| IMsg<#= msg.name #>
<# }
} #>

// Setter
<#
let mut setter_structs = Vec::new();

for e in &self.b2m.decls {
	// Update
	if e.op == RuleOp::Update {
		setter_structs.push(get_prefixed_name(e));
		#>

export interface OChange<#= get_prefixed_name(e) #> {
	<#= get_prefixed_name(e) #>: {
		<#= self.structs.get_struct_ids_ts(&e.book_struct.name) #>
	<#
	// Event IDs
	for r in &e.ids {
		match r {
			RuleKind::ArgumentMap { .. } |
			RuleKind::ArgumentFunction { .. } => { #>
		<#= r.from_name().to_mixed_case() #>: <# r.get_type().inner.fmt_ts_opts(_fmt, false)?; #>;
			<# }
			_ => {}
		}
	}

	// Event Props
	for r in &e.rules {
		#>
		<#= r.from_name().to_mixed_case() #>?: <# r.get_type_no_option().inner.fmt_ts_opts(_fmt, false)?; #>;
	<# }
#>
	};
}
<#
	} else if e.op == RuleOp::Remove {
		if e.rules.is_empty() {
			let args = get_all_arguments_ts(e, None);
			let name_add = get_first_argument_name(e, None);
			let struct_name = format!("{}Remove{}", e.book_struct.name, name_add);
			setter_structs.push(struct_name.clone());
	#>

export interface OChange<#= struct_name #> {
	<#= struct_name #>: {
		<#= self.structs.get_struct_ids_ts(&e.book_struct.name) #>
<#= args #>	};
}
	<#
		} else {
			for r in &e.rules {
				let args = get_all_arguments_ts(e, Some(r));
				let name_add = get_first_argument_name(e, Some(r));
				let struct_name = format!("{}Remove{}", e.book_struct.name, name_add);
				setter_structs.push(struct_name.clone());
	#>

export interface OChange<#= struct_name #> {
	<#= struct_name #>: {
		<#= self.structs.get_struct_ids_ts(&e.book_struct.name) #>
<#= args #>	};
}
		<# }
		}
	} else if e.op == RuleOp::Add {
		for r in &e.rules {
			let args = get_all_arguments_ts(e, Some(r));
			let struct_name = format!("{}Add{}", e.book_struct.name, r.from_name_singular());
			setter_structs.push(struct_name.clone());
	#>

export interface OChange<#= struct_name #> {
	<#= struct_name #>: {
		<#= self.structs.get_struct_ids_ts(&e.book_struct.name) #>
<#= args #>	};
}
	<#
		}
	}
} #>

export type OChange =
<#
let mut is_first = true;
for setter in &setter_structs {
	if is_first {
		is_first = false; #>
	OChange<#= setter #>
	<# } else { #>
	| OChange<#= setter #>
<# }
} #>
;
