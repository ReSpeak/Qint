{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qint",
  "version": "0.1.1",
  "identifier": "org.respeak.qint",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qint",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src blob: data: filesystem: ws: http: https: tauri: 'unsafe-eval' 'unsafe-inline'; script-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/32x32.png",
      "../assets/128x128.png",
      "../assets/128x128@2x.png",
      "../assets/icon.icns",
      "../assets/icon.ico"
    ]
  }
}