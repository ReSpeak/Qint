{
  "productName": "Qint",
  "version": "0.1.1",
  "identifier": "org.respeak.qint",
  "build": {
    "frontendDist": [
      "../frontend/dist"
    ],
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Qint",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src blob: data: filesystem: ws: http: https: tauri: 'unsafe-eval' 'unsafe-inline'"
    },
    "trayIcon": {
      "iconPath": "../assets/icon.ico"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../assets/32x32.png",
      "../assets/128x128.png",
      "../assets/128x128@2x.png",
      "../assets/icon.icns",
      "../assets/icon.ico"
    ]
  }
}