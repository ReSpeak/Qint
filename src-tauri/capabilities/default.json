{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "core:event:allow-listen",
    "core:window:allow-set-decorations",
    "http:default",
    "notification:default",
    "dialog:default",
    "shell:default"
  ]
}
