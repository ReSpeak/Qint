{
	// Place your Qint workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"Svelte ts boilerplate": {
		"scope": "svelte",
		"prefix": "svt",
		"body": [
			"<script lang=\"ts\">",
			"\t$1",
			"</script>",
		],
		"description": "Svelte ts boilerplate"
	},
	"Svelte module context ts boilerplate": {
		"scope": "svelte",
		"prefix": "svtmod",
		"body": [
			"<script lang=\"ts\" context=\"module\">",
			"\t$1",
			"</script>",
		],
		"description": "Svelte module context ts boilerplate"
	},
	"Svelte scss boilerplate": {
		"scope": "svelte",
		"prefix": "svs",
		"body": [
			"<style lang=\"scss\">",
			"\t$1",
			"</style>",
		],
		"description": "Svelte scss boilerplate"
	},
	"Svelte if:end": {
		"scope": "svelte",
		"prefix": "sif",
		"body": [
			"{#if $1}",
			"\t$2",
			"{/if}",
		],
		"description": "Svelte #if : /if"
	},
	"Svelte if:else:end": {
		"scope": "svelte",
		"prefix": "sife",
		"body": [
			"{#if $1}",
			"\t$2",
			"{:else}",
			"\t",
			"{/if}",
		],
		"description": "Svelte #if : else : /if"
	}
}
