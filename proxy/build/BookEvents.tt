		let<# if !e.rules.is_empty() { #> mut<# } #> packet = s.<#= change_name.to_snake_case() #>(<#= set_all_id_arguments(e) #>);
	<# for r in &e.rules {
		let type_s = r.get_type_no_option();
		let as_ref = if type_s == "&str" {
			".as_deref()"
		} else if type_s == "Option<&str>" {
			".as_ref().map(|o| o.as_deref())"
		} else {
			""
		};
		#>
		if let Some(p) = self.<#= r.from_name().to_snake_case() #><#= as_ref #> {
			packet = packet.set_<#= r.from_name().to_snake_case() #>(p);
		}
	<# } #>
