	// Event Props
	for r in &e.rules {
		let name = r.from_name_singular();
		#>
	#[serde(default, deserialize_with = "deserialize_some", skip_serializing_if = "Option::is_none")]
	pub <#= r.from_name().to_snake_case() #>: Option<<#= r.get_type_no_option_owned() #>>,
	<# }
#>
}

