<#@ template cleanws="true" #>
<#
use std::fmt;

use tsproto_structs::book_to_messages::{Event, RuleKind, RuleOp};

fn get_all_arguments<'a>(e: &'a Event<'a>, r: Option<&'a RuleKind<'a>>) -> String {
	let mut args = String::new();
	for r in e.ids.iter().chain(r.iter().cloned()) {
		match r {
			RuleKind::ArgumentMap { .. } |
			RuleKind::ArgumentFunction { .. } => {
				let arg = r.get_argument();
				if !arg.is_empty() {
					args.push_str("pub ");
					args.push_str(&arg);
					args.push_str(", ");
				}
			}
			_ => {}
		}
	}
	args
}

fn set_all_arguments<'a>(e: &'a Event<'a>, r: Option<&'a RuleKind<'a>>) -> String {
	let mut args = String::new();
	for r in e.ids.iter().chain(r.iter().cloned()) {
		match r {
			RuleKind::ArgumentMap { .. } |
			RuleKind::ArgumentFunction { .. } => {
				args.push_str("self.");
				args.push_str(&r.from_name().to_snake_case());
				args.push_str(", ");
			}
			_ => {}
		}
	}
	args
}

fn set_all_id_arguments<'a>(e: &'a Event<'a>) -> String {
	let mut args = String::new();
	for r in &e.ids {
		match r {
			RuleKind::ArgumentMap { .. } |
			RuleKind::ArgumentFunction { .. } => {
				args.push_str("self.");
				args.push_str(&r.from_name().to_snake_case());
				args.push_str(", ");
			}
			_ => {}
		}
	}
	args
}

fn get_struct(_fmt: &mut fmt::Formatter, name: &str) -> fmt::Result {
match name {
	"Channel" => { #>
		let s = con.channels.get(&self.id).ok_or_else(|| format_err!("Channel {} not found", self.id.0))?;
	<# }
	"Client" => { #>
		let s = con.clients.get(&self.id).ok_or_else(|| format_err!("Client {} not found", self.id.0))?;
	<# }
	"Connection" => { #>
		let s = con;
	<# }
	"Server" => { #>
		let s = &con.server;
	<# }
	"ServerGroup" => { #>
		let s = con.server_groups.get(&self.id).ok_or_else(|| format_err!("ServerGroup {} not found", self.id.0))?;
	<# }
	"ChannelGroup" => { #>
		let s = con.channel_groups.get(&self.id).ok_or_else(|| format_err!("ChannelGroup {} not found", self.id.0))?;
	<# }
	_ => panic!("Unimplemented get {}", name),
}
	Ok(())
}

fn get_struct_ids(structs: &JsStructs, mut name: &str) -> String {
	if name == "Connection" {
		name = "Server";
	}
	let struc = structs.get_struct(name).unwrap_or_else(|| panic!("Did not find struct '{}'", name));
	let mut ids = String::new();
	for i in &struc.ids {
		ids.push_str("pub ");
		ids.push_str(&i.0.to_snake_case());
		ids.push_str(": ");
		ids.push_str(&i.1);
		ids.push_str(", ");
	}
	ids
}

fn get_props(_fmt: &mut fmt::Formatter, structs: &[Struct], parts: &[&str]) -> fmt::Result {
	for p in get_all_properties(structs, parts) { #>
	#[serde(default, deserialize_with = "deserialize_some", skip_serializing_if = "Option::is_none")]
	pub <#= p.name.to_snake_case() #>: Option<<#= p.get_rust_type(false) #>>,
	<# }
	Ok(())
}

fn convert_ids(_fmt: &mut fmt::Formatter, name: &str, ids: &str, structs: &[Struct], parts: &[&str]) -> fmt::Result {
	for struc in structs {
		if !parts.contains(&struc.name.as_str()) {
			continue;
		} #>
			PropertyId::<#= struc.name #><#= ids #> => Ok(JsPropertyId::<#= name #><#= ids #>),
		<# for p in get_properties(structs, struc) {
			if p.modifier.is_none() { #>
			PropertyId::<#= struc.name #><#= p.get_name() #><#= ids #> => Ok(JsPropertyId::<#= name #><#= ids #>),
		<# }
		}
	}
	Ok(())
}

fn convert_value(_fmt: &mut fmt::Formatter, name: &str, ids: &str, structs: &[Struct], parts: &[&str]) -> fmt::Result {
	for struc in structs {
		if !parts.contains(&struc.name.as_str()) {
			continue;
		} #>
		PropertyId::<#= struc.name #><#= ids #> => if let PropertyValueRef::<#= struc.name #>(val) = p {
			Some(JsProperty::<#= name #>(Js<#= name #> {
		<# for p in get_all_properties(structs, parts) {
			if struc.properties.iter().any(|prop| prop.name == p.name) { #>
				<#= p.name.to_snake_case() #>: Some({
					<# let owned = get_to_owned(p);
					if owned == "val" { #>
					val.<#= p.name.to_snake_case() #><# if p.modifier.is_some() { #>.clone()<# } #>
					<# } else { #>
					let val = &val.<#= p.name.to_snake_case() #>;
					<#= owned #>
					<# } #>
				}),
			<# }
		} #>
				.. Default::default()
			}))
		} else {
			panic!("Got wrong PropertyValue type, expected <#= name #>");
		},
		<# for prop in get_properties(structs, struc) {
			if prop.modifier.is_none() {
				let type_s = prop.get_rust_type(false).replace('<', "_").replace('>', "").to_camel_case();
				#>
		PropertyId::<#= struc.name #><#= prop.get_name() #><#= ids #> => if let PropertyValueRef::<#= type_s #>(val) = p {
			Some(JsProperty::<#= name #>(Js<#= name #> {
		<# for p in get_all_properties(structs, parts) {
			if prop.name == p.name { #>
				<#= p.name.to_snake_case() #>: Some(<#= get_to_owned(p) #>),
			<# }
			} #>
				.. Default::default()
			}))
		} else {
			panic!("Got wrong PropertyValue type, expected <#= type_s #>");
		},
		<# }
		}
	}
	Ok(())
}

#>
#[derive(Clone, Debug, Default, Deserialize, PartialEq, Serialize)]
pub struct JsChannel {
<# get_props(_fmt, &self.structs, &["Channel", "OptionalChannelData"])?; #>
}

#[derive(Clone, Debug, Default, Deserialize, PartialEq, Serialize)]
pub struct JsChannelGroup {
<# get_props(_fmt, &self.structs, &["ChannelGroup"])?; #>
}

#[derive(Clone, Debug, Default, Deserialize, PartialEq, Serialize)]
pub struct JsClient {
<# get_props(_fmt, &self.structs, &["Client", "OptionalClientData", "ConnectionClientData"])?; #>
}

#[derive(Clone, Debug, Default, Deserialize, PartialEq, Serialize)]
pub struct JsServer {
<# get_props(_fmt, &self.structs, &["Server", "OptionalServerData", "ConnectionServerData"])?; #>
}

#[derive(Clone, Debug, Default, Deserialize, PartialEq, Serialize)]
pub struct JsServerGroup {
<# get_props(_fmt, &self.structs, &["ServerGroup"])?; #>
}

pub fn convert_event(con: &Connection, e: &Event) -> Option<JsEvent> {
	match e {
		Event::PropertyAdded { id, invoker, extra } => {
			Some(JsEvent::PropertyAdded {
				id: id.clone().try_into().ok()?,
				prop: property_to_js(id, con.get_property(id).ok()?)?,
				invoker: invoker.clone(),
				extra: extra.clone(),
			})
		}
		Event::PropertyChanged { id, invoker, extra, .. } => {
			Some(JsEvent::PropertyChanged {
				id: id.clone().try_into().ok()?,
				prop: property_to_js(id, con.get_property(id).ok()?)?,
				invoker: invoker.clone(),
				extra: extra.clone(),
			})
		}
		Event::PropertyRemoved { id, invoker, extra, .. } => {
			Some(JsEvent::PropertyRemoved {
				id: id.clone().try_into().ok()?,
				invoker: invoker.clone(),
				extra: extra.clone(),
			})
		}
		Event::ChannelListFinished => Some(JsEvent::ChannelListFinished),
		Event::Message { target, invoker, message } => Some(JsEvent::Message {
			target: *target, invoker: invoker.clone(), message: message.clone(),
		}),
	}
}

fn property_to_js(id: &PropertyId, p: PropertyValueRef) -> Option<JsProperty> {
	match id {
<# convert_value(_fmt, "Channel", "(_)", &self.structs, &["Channel", "OptionalChannelData"])?; #>
<# convert_value(_fmt, "ChannelGroup", "(_)", &self.structs, &["ChannelGroup"])?; #>
<# convert_value(_fmt, "Client", "(_)", &self.structs, &["Client", "OptionalClientData", "ConnectionClientData"])?; #>
<# convert_value(_fmt, "Server", "", &self.structs, &["Server", "OptionalServerData", "ConnectionServerData"])?; #>
<# convert_value(_fmt, "ServerGroup", "(_)", &self.structs, &["ServerGroup"])?; #>
		_ => None,
	}
}

impl TryFrom<PropertyId> for JsPropertyId {
	type Error = ();
	fn try_from(id: PropertyId) -> Result<Self, ()> {
		match id {
<# convert_ids(_fmt, "Channel", "(id)", &self.structs, &["Channel", "OptionalChannelData"])?; #>
<# convert_ids(_fmt, "ChannelGroup", "(id)", &self.structs, &["ChannelGroup"])?; #>
<# convert_ids(_fmt, "Client", "(id)", &self.structs, &["Client", "OptionalClientData", "ConnectionClientData"])?; #>
<# convert_ids(_fmt, "Server", "", &self.structs, &["Server", "OptionalServerData", "ConnectionServerData"])?; #>
<# convert_ids(_fmt, "ServerGroup", "(id)", &self.structs, &["ServerGroup"])?; #>
			_ => Err(()),
		}
	}
}

