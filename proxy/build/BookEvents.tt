		#>

#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct <#= get_prefixed_name(e) #> {
<#= self.structs.get_struct_ids(&e.book_struct.name) #>
	<#
