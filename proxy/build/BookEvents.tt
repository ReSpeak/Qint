<#@ template cleanws="true" #>
<#
use std::fmt;

let structs = filter_structs(&self.book.structs);

fn get_struct(_fmt: &mut fmt::Formatter, name: &str) -> fmt::Result {
match name {
	"Channel" => { #>
		let s = con.channels.get(&self.id).ok_or_else(|| format_err!("Channel {} not found", self.id.0))?;
	<# }
	"Client" => { #>
		let s = con.clients.get(&self.id).ok_or_else(|| format_err!("Client {} not found", self.id.0))?;
	<# }
	"Connection" => { #>
		let s = con;
	<# }
	"Server" => { #>
		let s = &con.server;
	<# }
	"ServerGroup" => { #>
		let s = con.server_groups.get(&self.id).ok_or_else(|| format_err!("ServerGroup {} not found", self.id.0))?;
	<# }
	"ChannelGroup" => { #>
		let s = con.channel_groups.get(&self.id).ok_or_else(|| format_err!("ChannelGroup {} not found", self.id.0))?;
	<# }
	_ => panic!("Unimplemented get {}", name),
}
	Ok(())
}

fn convert_ids(_fmt: &mut fmt::Formatter, struc: &Struct, structs: &[&Struct]) -> fmt::Result {
	let ids = get_id_args(struc.id.len(), true);
	let ids_wrapped = if ids.is_empty() {
		"()"
	} else {
		&ids
	};
	#>
			PropertyId::<#= struc.name #><#= ids #> => Ok(JsPropertyId::<#= struc.name #><#= ids_wrapped #>),
	<#
	if struc.opt {
		return Ok(());
	}
	for p in get_properties(structs, struc) {
		if let Some(modifier) = &p.modifier {
			let ids = get_id_args(struc.id.len() + 1, true);
			let ids_wrapped = if ids.is_empty() {
				"()"
			} else {
				&ids
			};
			if modifier == "array" || modifier == "set" {
			#>
			PropertyId::<#= struc.name #><#= p.get_name() #><#= ids #> => Ok(JsPropertyId::<#= struc.name #><#= p.get_name() #><#= ids_wrapped #>),
			<#
			} else {
				panic!("Unknown modifier {}", modifier);
			}
		} else { #>
			PropertyId::<#= struc.name #><#= p.get_name() #><#= ids #> => Ok(JsPropertyId::<#= struc.name #><#= ids_wrapped #>),
	<# }
	}
	Ok(())
}

fn convert_value(_fmt: &mut fmt::Formatter, book_events: &BookEvents, struc: &Struct, structs: &[&Struct]) -> fmt::Result {
	let ids = get_id_args(struc.id.len(), false);
	#>
		PropertyId::<#= struc.name #><#= ids #> => if let PropertyValueRef::<#= struc.name #>(val) = p {
		<# if struc.opt { #>
			if let Some(val) = val {
		<# } #>
			Some(JsProperty::<#= struc.name #>(val.into()))
		<# if struc.opt { #>
			} else { None }
		<# } #>
		} else {
			panic!("Got wrong PropertyValue type, expected <#= struc.name #>");
		},
	<#
	if struc.opt {
		return Ok(());
	}
	for prop in get_properties(structs, struc) {
		let type_s = prop.get_inner_type()?.to_name();
		let ids2;
		let ids = if prop.modifier.is_some() {
			ids2 = get_id_args(struc.id.len() + 1, false);
			&ids2
		} else {
			&ids
		};
		#>
		PropertyId::<#= struc.name #><#= prop.get_name() #><#= ids #> => if let PropertyValueRef::<#= type_s #>(val) = p {
		<#
		if let Some(modifier) = &prop.modifier {
			if modifier == "array" || modifier == "set" { #>
			Some(JsProperty::<#= type_s #>(<#= get_to_owned(prop) #>))
			<# } else {
				panic!("Unknown modifier {}", modifier);
			}
		} else { #>
			Some(JsProperty::<#= struc.name #>(js_structs::<#= struc.name #> {
	<# for p in get_properties(structs, struc) {
		if prop.name == p.name { #>
				<#= p.name.to_snake_case() #>: Some(<#= get_to_owned(p) #>),
			<#
			if book_events.has_render(&struc.name, &p.name) {
				let rendered = if p.opt {
					"val.as_ref().map(|val| crate::markdown::markdown(&val))"
				} else {
					"Some(crate::markdown::markdown(&val))"
				}; #>
				<#= p.name.to_snake_case() #>_rendered: <#= rendered #>,
			<# }
			}
		} #>
				.. Default::default()
			}))
	<# } #>
		} else {
			panic!("Got wrong PropertyValue type, expected <#= type_s #>");
		},
<# }
	Ok(())
}

#>
pub mod js_structs {
	use std::collections::HashSet;
	use std::net::{IpAddr, SocketAddr};

	use serde::Serialize;
	use time::{Duration, OffsetDateTime};
	use tsclientlib::{ChannelGroupId, ChannelId, ChannelPermissionHint, ChannelType, ClientDbId,
		ClientId, ClientPermissionHint, ClientType, Codec, CodecEncryptionMode, GroupNamingMode,
		GroupType, HostBannerMode, HostMessageMode, IconId, LicenseType, MaxClients, ServerGroupId,
		TalkPowerRequest, Uid};
	use tsproto_types::crypto::EccKeyPubP256;

	use super::{serialize_some_date_time, serialize_some_duration, serialize_some_id,
		serialize_some_set_id, serialize_some_some_duration, serialize_some_some_id,
		serialize_some_some_u64, serialize_some_u64};

<# for struc in &structs { #>
#[derive(Debug, Default, Serialize)]
#[cfg_attr(test, derive(Deserialize))]
#[serde(rename_all = "camelCase")]
pub struct <#= struc.name #> {
	<# for p in &struc.properties {
		let struct_type = p.get_type()?;
		let attr = get_serde_attr(&struct_type.inner, true);
		let name = p.name.to_snake_case();
		#>
	<#= attr #>
	pub(crate) <#= name #>: Option<<#= struct_type #>>,
	<#
		if self.has_render(&struc.name, &name.to_camel_case()) { #>
	#[serde(default, deserialize_with = "deserialize_some", skip_serializing_if = "Option::is_none")]
	pub(crate) <#= name #>_rendered: Option<String>,
		<# }
	} #>
}

impl From<&'_ tsclientlib::data::<#= struc.name #>> for <#= struc.name #> {
	fn from(val: &tsclientlib::data::<#= struc.name #>) -> Self {
		<#= struc.name #> {
	<# for p in &struc.properties {
		let owned = get_to_owned(p);

		let mut getter;
		if owned == "val" {
			getter = format!("val.{}", p.name.to_snake_case());
			if p.modifier.is_some() {
				getter.push_str(".clone()");
			}
		} else {
			getter = format!("{{\n\t\t\t\t\tlet val = &val.{};\n\t\t\t\t\t{}\n\t\t\t\t}}", p.name.to_snake_case(), owned);
		}

		if self.book.structs.iter().any(|s| s.name == p.type_s) {
			// Need to convert inner type
			if p.opt {
				getter = format!("val.{}.as_ref().map({}::from)", p.name.to_snake_case(), p.type_s);
			} else if p.modifier.as_ref().map(|m| m == "set").unwrap_or_default() {
				getter = format!("val.{}.iter().map({}::from).collect()", p.name.to_snake_case(), p.type_s);
			} else if p.modifier.as_ref().map(|m| m == "map").unwrap_or_default() {
				getter = format!("val.{}.iter().map(|(k, v)| (*k, v.into())).collect()", p.name.to_snake_case());
			} else {
				getter = format!("(&val.{}).into()", p.name.to_snake_case());
			}
		}
		#>
			<#= p.name.to_snake_case() #>: Some(<#= getter #>),
		<#
		if self.has_render(&struc.name, &p.name) {
			let rendered = if p.opt {
				format!("val.{}.as_deref().map(crate::markdown::markdown)", p.name.to_snake_case())
			} else {
				format!("crate::markdown::markdown(&val.{})", p.name.to_snake_case())
			}; #>
			<#= p.name.to_snake_case() #>_rendered: Some(<#= rendered #>),
	<# }
	} #>
		}
	}
}

<# } #>
}

#[derive(Clone, Debug, Serialize)]
#[cfg_attr(test, derive(Deserialize))]
pub enum JsPropertyId {
<# for struc in &structs { #>
	<#= struc.name #>(
	<# for id in &struc.id {
		let p = id.find_property(&self.book.structs);
		let struct_type = p.get_type()?;
		let attr = get_serde_attr(&struct_type.inner, false);
		#>
		<#= attr #>
		<#= struct_type #>,
	<# } #>
	),
<# } #>
	ClientServerGroup(
		#[serde(deserialize_with = "deserialize_id", serialize_with = "serialize_id")]
		ClientId,
		#[serde(deserialize_with = "deserialize_id", serialize_with = "serialize_id")]
		ServerGroupId,
	),
	ServerIp(IpAddr),
}

#[derive(Debug, Serialize)]
#[cfg_attr(test, derive(Deserialize))]
pub enum JsProperty {
<# for struc in &structs { #>
	<#= struc.name #>(js_structs::<#= struc.name #>),
<# } #>
	IpAddr(IpAddr),
	ServerGroupId(ServerGroupId),
}

pub fn convert_event(con: &Connection, e: &Event) -> Option<JsEvent> {
	match e {
		Event::PropertyAdded { id, invoker, extra } => {
			Some(JsEvent::PropertyAdded {
				id: id.clone().try_into().ok()?,
				prop: property_to_js(id, con.get_property(id).ok()?)?,
				invoker: invoker.clone(),
				extra: extra.clone(),
			})
		}
		Event::PropertyChanged { id, invoker, extra, .. } => {
			Some(JsEvent::PropertyChanged {
				id: id.clone().try_into().ok()?,
				prop: property_to_js(id, con.get_property(id).ok()?)?,
				invoker: invoker.clone(),
				extra: extra.clone(),
			})
		}
		Event::PropertyRemoved { id, invoker, extra, .. } => {
			Some(JsEvent::PropertyRemoved {
				id: id.clone().try_into().ok()?,
				invoker: invoker.clone(),
				extra: extra.clone(),
			})
		}
		Event::Message { target, invoker, message } => Some(JsEvent::Message {
			target: *target, invoker: invoker.clone(), message: message.clone(),
		}),
	}
}

fn property_to_js(id: &PropertyId, p: PropertyValueRef) -> Option<JsProperty> {
	match id {
<# for struc in &structs {
	convert_value(_fmt, self, struc, &structs)?;
} #>
		_ => None,
	}
}

impl TryFrom<PropertyId> for JsPropertyId {
	type Error = ();
	fn try_from(id: PropertyId) -> Result<Self, ()> {
		match id {
<# for struc in &structs {
	convert_ids(_fmt, struc, &structs)?;
} #>
			_ => Err(()),
		}
	}
}

// Messages

<# for msg in &self.js_in_messages.0 { #>
<# if !msg.attributes.is_empty() { #>
#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
pub struct JsIn<#= msg.name #>(Vec<JsIn<#= msg.name #>Part>);

#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct JsIn<#= msg.name #>Part {
<# for a in &msg.attributes {
	let field = self.messages.get_field(a);
	let rust_type = field.get_type(a)?;
	let attr = get_serde_attr(&rust_type.inner, false);
	if !attr.is_empty() { #>
	<#= attr #>
	<# } #>
	<#= field.pretty.to_snake_case() #>: <#= rust_type #>,
	<#
		if self.has_render(&msg.name, &field.pretty) {
			if rust_type.is_opt() { #>
	#[serde(default, deserialize_with = "deserialize_some", skip_serializing_if = "Option::is_none")]
			<# } #>
	<#= field.pretty.to_snake_case() #>_rendered: <# if rust_type.is_opt() {
		#>Option<<# } #>String<# if rust_type.is_opt() { #>><# } #>,
	<# } #>
<# } #>
}

impl<'a> From<&'a messages::s2c::In<#= msg.name #>Part> for JsIn<#= msg.name #>Part {
	fn from(p: &'a messages::s2c::In<#= msg.name #>Part) -> Self {
		Self {
		<# for a in &msg.attributes {
			let field = self.messages.get_field(a);
			let rust_type = field.get_type(a)?;
			#>
			<#= field.pretty.to_snake_case() #>: p.<#= field.pretty.to_snake_case() #>.clone(),
			<#
			if self.has_render(&msg.name, &field.pretty) {
				let rendered = if rust_type.is_opt() {
					format!("p.{}.as_deref().map(crate::markdown::markdown)", field.pretty.to_snake_case())
				} else {
					format!("crate::markdown::markdown(&p.{})", field.pretty.to_snake_case())
				}; #>
			<#= field.pretty.to_snake_case() #>_rendered: <#= rendered #>,
			<# }
			} #>
		}
	}
}

<# } else { #>
#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
pub struct JsIn<#= msg.name #>;

<# } #>
<# } #>
#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
pub enum JsInMessage {
<# for msg in &self.js_in_messages.0 { #>
	<#= msg.name #>(JsIn<#= msg.name #>),
<# } #>
}

pub fn convert_message(msg: &InMessage) -> Option<JsInMessage> {
	match msg {
<# for msg in &self.js_in_messages.0 { #>
	<# if !msg.attributes.is_empty() { #>
		InMessage::<#= msg.name #>(msg) => Some(JsInMessage::<#= msg.name #>(JsIn<#= msg.name #>(msg.iter().map(|p| p.into()).collect()))),
	<# } else { #>
		InMessage::<#= msg.name #>(_) => Some(JsInMessage::<#= msg.name #>(JsIn<#= msg.name #>)),
	<# } #>
<# } #>
		_ => None,
	}
}

