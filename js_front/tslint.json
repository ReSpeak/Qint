{
	"extends": "tslint:recommended",
	"rules": {
		"max-line-length": {
			"options": [
				120
			]
		},
		"indent": false,
		"arrow-parens": false,
		"trailing-comma": false,
		"ordered-imports": false,
		"max-classes-per-file": false,
		"curly": false,
		"variable-name": false,
		"no-empty": false,
		"no-console": false,
		"member-ordering": false
	}
}
